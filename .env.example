# Automated CV Scanner
# .env.example

# ============================================================================
# Environment Configuration Template for Automated CV Scanner
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in all values with your credentials
# 3. NEVER commit .env to version control
# 4. Add .env to your .gitignore
#
# ============================================================================

# --- N8N Configuration ---
N8N_INSTANCE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
N8N_ENCRYPTION_KEY=your-random-encryption-key-here

# --- Google Cloud Configuration ---
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=cv-scanner-sa@your-project.iam.gserviceaccount.com

# Google Sheets API
GOOGLE_SHEETS_SPREADSHEET_ID=1M17HMifACUI7GzTHLlGm32LPoe9LkQ2jJm-1TbNB4ig
GOOGLE_SHEETS_JOB_DESCRIPTIONS_ID=12suMNgMvxJLu6zf785QuUkmH-vAHZt4GfQNnDvY3nUU
GOOGLE_SHEETS_SHEET_NAME=Sheet1
GOOGLE_SHEETS_CREDENTIALS_JSON=path/to/cv-scanner-key.json

# Google Gemini API
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_MODEL=gemini-2.0-flash

# Gmail API
GMAIL_SENDER_EMAIL=hiring@yourcompany.com
GMAIL_SENDER_NAME=Your Company Hiring Team

# --- Mistral AI Configuration ---
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_OCR_MODEL=mistral-large-vision

# --- Application Configuration ---
# Qualification scoring threshold (0.0 to 1.0)
QUALIFICATION_THRESHOLD=0.75

# Email template configuration
EMAIL_INVITATION_SUBJECT=Congratulations! Interview Invitation
EMAIL_REJECTION_SUBJECT=Thank You for Your Application

# Logging and monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Security & Compliance ---
# Enable audit logging to Sheets
AUDIT_LOG_ENABLED=true

# Rate limiting (requests per minute per API)
GOOGLE_SHEETS_RATE_LIMIT=60
GEMINI_RATE_LIMIT=100
MISTRAL_RATE_LIMIT=100

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# --- Development/Testing Configuration ---
# Set to true to enable mock responses (for testing without API calls)
MOCK_MODE=false

# Set to true to log full request/response payloads
DEBUG_VERBOSE=false

# Comma-separated list of test email addresses for dry runs
TEST_EMAILS=test@example.com,admin@example.com