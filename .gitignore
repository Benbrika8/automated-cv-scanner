# Automated CV Scanner
# .gitignore

# ============================================================================
# Automated CV Scanner - Git Ignore Rules
# ============================================================================

# --- Environment & Credentials (CRITICAL) ---
.env
.env.local
.env.*.local
*.pem
*.key
cv-scanner-key.json
credentials.json
secrets/
private/

# --- n8n Specific ---
.n8n/
.n8n/nodes/
node_modules/
dist/

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.code-workspace

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.temp
.cache/

# --- OS-specific ---
Thumbs.db
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# --- Local Testing ---
examples/outputs/local_test_*
test_results/
coverage/
.coverage

# --- Build Artifacts ---
build/
out/
dist/
*.tar.gz
*.zip

# --- Documentation Generated Files ---
docs/_site/
docs/.jekyll-cache/

# --- Sensitive Examples (if needed) ---
examples/sample_responses_with_pii/

# Allow tracked files (use for important templates)
!.env.example
!.gitkeep